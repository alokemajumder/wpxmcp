# ---------------------------------------------------------------------------
# wpxmcp — local (stdio) configuration
#
# Copy to .env and fill in. For the remote Cloudflare deployment these same
# names become Worker Secrets instead — see docs/DEPLOY_CLOUDFLARE.md.
# ---------------------------------------------------------------------------

# --- Single site ------------------------------------------------------------
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=your-wp-username
# wp-admin → Users → Profile → Application Passwords. Keep the spaces.
WORDPRESS_APP_PASSWORD=abcd EFGH ijkl MNOP qrst UVWX

# --- Several sites ----------------------------------------------------------
# Either point at a JSON file...
# WPX_SITES_FILE=~/.wpxmcp/sites.json
#
# ...or inline the JSON:
# WPX_SITES=[{"id":"blog","url":"https://blog.example.com","username":"admin","appPassword":"..."}]
#
# ...or use one env triple per site:
# WP_SITE_BLOG_URL=https://blog.example.com
# WP_SITE_BLOG_USERNAME=admin
# WP_SITE_BLOG_APP_PASSWORD=abcd EFGH ijkl MNOP
# WP_SITE_BLOG_READONLY=true

# Which site tools target when site_id is omitted. Defaults to the first.
# WPX_DEFAULT_SITE=blog

# --- Optional ---------------------------------------------------------------
# Stock photo search (search_stock_photos). Both are free to obtain.
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# Where the audit log and saved skills live. Defaults to ~/.wpxmcp
# WPX_HOME=~/.wpxmcp

# Set to "off" to disable local audit logging.
# WPX_AUDIT=

# Allow the `wp eval` command, which executes arbitrary PHP. Off for good reason.
# WPX_ALLOW_EVAL=false
