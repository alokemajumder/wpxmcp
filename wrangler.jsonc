{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wpxmcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",

  // nodejs_compat gives the Worker Node's built-in module surface. wpxmcp itself
  // avoids Node APIs on the Workers path, but the MCP SDK pulls in a few.
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "vars": {
    // Non-secret configuration only. Everything sensitive is a Worker Secret —
    // see docs/DEPLOY_CLOUDFLARE.md. Never put a password or token in this file:
    // it is committed to the repository.
    "WPX_ALLOWED_ORIGINS": ""
  }

  // Optional: a durable audit trail that survives isolate eviction.
  // Create it with `npx wrangler kv namespace create WPX_AUDIT`, then uncomment
  // and paste the id Wrangler prints.
  //
  // "kv_namespaces": [
  //   { "binding": "WPX_AUDIT", "id": "<paste-the-id-here>" }
  // ]
}
